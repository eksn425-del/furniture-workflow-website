# Copy to .env.local. Keep the copy local and never commit it.
APP_ENV=development
OUTPUT_ROOT=
WORKFLOW_RELEASE_VERSION=0.16.0
DATABASE_URL=

# Local review is offline by default.
LOCAL_REVIEW_MODE=agent
WEBSITE_MODEL_MODE=LOCAL_AGENT
PROVIDER_MODE=disabled

# Public-site L2 browser. The default uses Playwright's isolated Chromium;
# install it once with: python -m playwright install chromium.
# Set msedge or chrome only when that system browser is installed; the Website
# still uses a separate persistent profile and never the user's personal one.
WEBSITE_L2_BROWSER_ENGINE=chromium
WEBSITE_L2_NAVIGATION_TIMEOUT_MS=15000
WEBSITE_BROWSER_HANDOFF_SECONDS=180
WEBSITE_L2_COUNT_PROBES=4

# Optional Website Brain. Supply values only in a private local environment.
WEBSITE_BRAIN_API_KEY=
WEBSITE_BRAIN_BASE_URL=
WEBSITE_BRAIN_MODEL=
WEBSITE_BRAIN_TIMEOUT_SECONDS=25
WEBSITE_BRAIN_MAX_RETRIES=2
WEBSITE_BRAIN_RPM_LIMIT=30

# Optional 3D provider. The public repository intentionally contains no endpoint or key.
LUX3D_API_KEY=
LUX3D_BASE_URL=
LUX3D_VERSION=v3.0-standard
LUX3D_FACE_COUNT=60000
LUX3D_QUERY_INTERVAL=15
LUX3D_QUERY_MAX_ATTEMPTS=80

# Optional local model post-processing.
MODELING_ENABLED=false
EXACT_COUNT_AUTHORIZATION=false
BLENDER_WORKER_ENABLED=false
BLENDER_EXECUTABLE=
AUTO_MODEL_COST_CEILING_MINOR=0
MODEL_ESTIMATED_COST_PER_ITEM_MINOR=0

# Optional local service protection. Never put real values in Git.
INTERNAL_SERVICE_TOKEN=
INTRANET_AUTH_USER=
INTRANET_AUTH_PASSWORD=
